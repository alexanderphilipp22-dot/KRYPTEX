<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; all real styling is Compose Material 3. Always black, whatever the
         system theme: nothing flashes light before the first frame, and the bars keep light icons. -->
    <style name="Base.Theme.Kryptex" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Already dark by design: vendor "force dark" modes must not repaint it. -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.Kryptex" parent="Base.Theme.Kryptex" />
</resources>
